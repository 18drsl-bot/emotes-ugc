local function splitWords(query)
    local words = {}
    for word in query:gmatch("%S+") do words[#words + 1] = word end
    return words
end

local sfind = string.find
local function matchWords(item, words)
    local name, sid = item.lname, item.sid
    for i = 1, #words do
        local w = words[i]
        if not sfind(name, w, 1, true) and not sfind(sid, w, 1, true) then
            return false
        end
    end
    return true
end

local function matches(item, query) -- small lists (binds)
    return matchWords(item, splitWords(query))
end

-- Filters `pool` for `query`. With `shouldAbort` it yields every few thousand
-- items so typing in a 50k-item list never freezes the game.
local function filterList(pool, query, shouldAbort)
    local words = splitWords(query)
    local out, n = {}, 0
    for i = 1, #pool do
        local item = pool[i]
        if matchWords(item, words) then
            n = n + 1
            out[n] = item
        end
        if shouldAbort and i % 10000 == 0 then
            task.wait()
            if shouldAbort() then return nil end
        end
    end
    return out
end

local function sourceForTab()
    if state.tab == "Emotes" then
        return state.emotes
    elseif state.tab == "Packs" then
        return state.packs
    end
    return state.favorites
end

local function currentList()
    local source = sourceForTab()
    if state.search == "" then return source end

    local c = state.filterCache
    if c and c.source == source and c.query == state.search then
        return c.list
    end
    local out = filterList(source, state.search, nil)
    state.filterCache = { source = source, query = state.search, list = out }
    return out
end

