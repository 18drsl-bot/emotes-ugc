-- Emote and anim pack lists are saved to the workspace (EmoteHub/EmoteList.json and
-- PackList.json) the first time they download. After that they load straight from
-- disk (works offline) and the script only refreshes them in the background.
function UIX.toEmoteItems(list)
    local out, n = {}, 0
    for _, item in pairs(list) do
        local id = tonumber(item.id or item[1])
        if id and id > 0 then
            local name = item.name or item[2]
            table.insert(out, decorate({
                kind = "emote",
                id = id,
                name = tostring(name or ("Emote_" .. id)),
            }))
            n = n + 1
            if n % 4000 == 0 then task.wait() end
        end
    end
    return out
end

task.spawn(function()
    setStatus("Loading emotes...", true)
    local haveSaved = false

    local saved = readJson(UIX.EMOTELIST_FILE)
    if saved then
        local items = UIX.toEmoteItems(saved)
        if #items > 0 then
            haveSaved = true
            state.emotes = items
            state.loadingEmotes = false
            if gui.Parent and state.tab == "Emotes" then render() end
            setStatus(("Loaded %d emotes from your saved copy"):format(#items))
        end
    end

    local list = UIX.fetchList(UIX.EMOTE_URL)
    if list then
        local fresh = UIX.toEmoteItems(list)
        if #fresh > 0 then
            local changed = (not haveSaved) or #fresh ~= #state.emotes
            if changed then
                state.emotes = fresh
                state.loadingEmotes = false
                if gui.Parent and state.tab == "Emotes" then render() end
                local packed = {}
                for i, e in ipairs(fresh) do packed[i] = { e.id, e.name } end
                writeJson(UIX.EMOTELIST_FILE, packed)
            end
            setStatus(("Loaded %d emotes"):format(#fresh))
        end
    end

    if #state.emotes == 0 then
        state.emotes = {
            decorate({ kind = "emote", id = 3360686498, name = "Stadium" }),
            decorate({ kind = "emote", id = 3360692915, name = "Tilt" }),
            decorate({ kind = "emote", id = 3576968026, name = "Shrug" }),
            decorate({ kind = "emote", id = 3360689775, name = "Salute" }),
        }
        setStatus("Offline - showing a few default emotes")
    end
    state.loadingEmotes = false
    if gui.Parent and state.tab == "Emotes" and not haveSaved then render() end
end)

function UIX.toPackItems(list, seen, out)
    local n = 0
    for _, item in pairs(list) do
        local id = tonumber(item.id)
        if id and id > 0 and not seen[id] and item.bundledItems then
            seen[id] = true
            table.insert(out, decorate({
                kind = "pack",
                id = id,
                name = tostring(item.name or ("Animation_" .. id)),
                bundledItems = item.bundledItems,
            }))
            n = n + 1
            if n % 2000 == 0 then task.wait() end
        end
    end
end

task.spawn(function()
    local haveSaved = false

    local saved = readJson(UIX.PACKLIST_FILE)
    if saved then
        local items = {}
        UIX.toPackItems(saved, {}, items)
        if #items > 0 then
            haveSaved = true
            state.packs = items
            refreshChipLabels()
            state.loadingPacks = false
            if gui.Parent and state.tab == "Packs" then render() end
        end
    end

    local packs, seen = {}, {}
    for _, url in ipairs(UIX.PACK_URLS) do
        local list = UIX.fetchList(url)
        if list then UIX.toPackItems(list, seen, packs) end
    end

    if #packs > 0 and ((not haveSaved) or #packs ~= #state.packs) then
        state.packs = packs
        refreshChipLabels()
        state.loadingPacks = false
        if gui.Parent and state.tab == "Packs" then render() end
        local out = {}
        for i, pk in ipairs(packs) do
            out[i] = { id = pk.id, name = pk.name, bundledItems = pk.bundledItems }
        end
        writeJson(UIX.PACKLIST_FILE, out)
    end

    state.loadingPacks = false
    if gui.Parent and state.tab == "Packs" and not haveSaved then render() end
end)
