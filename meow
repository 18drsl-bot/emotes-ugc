local searchToken = 0
searchBox:GetPropertyChangedSignal("Text"):Connect(function()
    searchToken = searchToken + 1
    local token = searchToken
    task.delay(0.2, function()
        if token ~= searchToken or not gui.Parent then return end
        local query = searchBox.Text:match("^%s*(.-)%s*$"):lower()
        if query == "" then
            state.search = ""
            render()
            return
        end

        local source = sourceForTab()
        local c = state.filterCache
        local pool = source
        -- typing more letters only needs to look through the previous matches
        if c and c.source == source and c.query ~= "" and query:sub(1, #c.query) == c.query then
            pool = c.list
        end
        local out = filterList(pool, query, function()
            return token ~= searchToken or not gui.Parent
        end)
        if not out then return end -- a newer search took over

        state.filterCache = { source = source, query = query, list = out }
        state.search = query
        render()
    end)
end)

