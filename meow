local chipNames = { src = nil, map = {} }
-- Show which pack is applied to each part (or "default") under each chip label
local function refreshChipLabels()
    local function nameOf(id)
        if id == nil then return nil end
        -- id -> name map is built only when a pack is actually applied,
        -- and rebuilt only when the pack list itself changes
        if chipNames.src ~= state.packs then
            chipNames.src = state.packs
            chipNames.map = {}
            for _, p in ipairs(state.packs) do
                chipNames.map[tostring(p.id)] = p.name
            end
        end
        local sid = tostring(id)
        return chipNames.map[sid] or sid
    end
    for i, cat in ipairs(PACK_CATS) do
        local applied
        if cat.key then
            applied = nameOf(state.activeParts[cat.key]) or nameOf(state.activePack)
        else
            applied = nameOf(state.activePack)
        end
        local text = cat.label .. "\n" .. (applied or "default")
        if chipButtons[i].Text ~= text then chipButtons[i].Text = text end
    end
end

