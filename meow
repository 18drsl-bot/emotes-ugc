-- Dragging (move / resize / slider) - one shared input handler
------------------------------------------------------------------------
local drag = nil

local function isPointer(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
end

local function beginDrag(mode, input)
    drag = {
        mode = mode,
        start = Vector2.new(input.Position.X, input.Position.Y),
        pos = main.Position,
        size = main.AbsoluteSize,
    }
end

titleBar.InputBegan:Connect(function(input)
    if isPointer(input) then beginDrag("move", input) end
end)

UIX.grip.InputBegan:Connect(function(input)
    if isPointer(input) then beginDrag("resize", input) end
end)

UIX.sliderHit.InputBegan:Connect(function(input)
    if isPointer(input) then
        beginDrag("slider", input)
        setSpeedFromX(input.Position.X)
    end
end)

table.insert(conns, UserInputService.InputChanged:Connect(function(input)
    if not drag then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    local delta = Vector2.new(input.Position.X, input.Position.Y) - drag.start
    if drag.mode == "move" then
        main.Position = UDim2.new(
            drag.pos.X.Scale, drag.pos.X.Offset + delta.X,
            drag.pos.Y.Scale, drag.pos.Y.Offset + delta.Y
        )
    elseif drag.mode == "resize" then
        local w = math.clamp(drag.size.X + delta.X, UIX.MIN_W, UIX.MAX_W)
        local h = math.clamp(drag.size.Y + delta.Y, UIX.MIN_H, UIX.MAX_H)
        sizeNow = Vector2.new(w, h)
        main.Size = UDim2.fromOffset(w, h)
    elseif drag.mode == "slider" then
        setSpeedFromX(input.Position.X)
    end
end))

table.insert(conns, UserInputService.InputEnded:Connect(function(input)
    if not drag or not isPointer(input) then return end
    local mode = drag.mode
    drag = nil
    if mode == "move" then
        state.posX, state.posY = main.Position.X.Offset, main.Position.Y.Offset
    end
    saveSettings()
end))

