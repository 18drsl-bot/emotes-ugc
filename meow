function UIX.round2(v)
    return math.floor(v * 100 + 0.5) / 100
end

local function refreshSpeedVisuals()
    local frac = math.clamp((state.speed - UIX.SPEED_MIN) / (UIX.SPEED_MAX - UIX.SPEED_MIN), 0, 1)
    UIX.knob.Position = UDim2.new(frac, 0, 0.5, 0)
    UIX.fill.Size = UDim2.new(frac, 0, 1, 0)
    UIX.speedBox.Text = tostring(state.speed)
end

local function setSpeed(v)
    v = UIX.round2(math.clamp(v, UIX.SPEED_MIN, UIX.SPEED_BOX_MAX))
    state.speed = v
    refreshSpeedVisuals()
    if state.track then
        pcall(function() state.track:AdjustSpeed(v) end)
    end
end

local function setSpeedFromX(x)
    local abs = UIX.track.AbsolutePosition.X
    local width = UIX.track.AbsoluteSize.X
    if width <= 0 then return end
    local frac = math.clamp((x - abs) / width, 0, 1)
    setSpeed(UIX.SPEED_MIN + frac * (UIX.SPEED_MAX - UIX.SPEED_MIN))
end

UIX.speedBox.FocusLost:Connect(function()
    local cleaned = (UIX.speedBox.Text:gsub("[^%d%.]", ""))
    local n = tonumber(cleaned)
    if n then
        setSpeed(n)
    else
        refreshSpeedVisuals()
    end
    saveSettings()
end)

