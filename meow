------------------------------------------------------------------------
-- Virtual grid: only the rows on screen (plus one above and below) exist,
-- so scrolling through thousands of items stays smooth.
------------------------------------------------------------------------
-- Thumbnails are requested only after scrolling pauses briefly, so flicking
-- through thousands of rows doesn't fire thousands of image loads.
local imageToken = 0
state.scheduleImages = function()
    imageToken = imageToken + 1
    local token = imageToken
    task.delay(0.07, function()
        if token ~= imageToken then return end
        for _, card in pairs(activeCards) do
            local want = card.wantImage
            if want and card.thumb.Image ~= want then
                card.thumb.Image = want
            end
        end
    end)
end

local ROW_H = CELL_H + PAD
local layoutCols = 0
local layoutQueued = false
local canvasRows = -1

local function layoutVisible(force)
    if state.tab == "Binds" or state.tab == "Settings" then return end
    local view = state.view
    local total = #view
    local width = listFrame.AbsoluteSize.X - 10 -- room for the scroll bar
    local cols = math.max(1, math.floor((width + PAD) / (CELL_W + PAD)))
    local rows = math.ceil(total / cols)

    if cols ~= layoutCols then
        force = true
        layoutCols = cols
    end
    if rows ~= canvasRows then
        canvasRows = rows
        listFrame.CanvasSize = UDim2.fromOffset(0, rows > 0 and (rows * ROW_H + PAD) or 0)
    end

    local y = listFrame.CanvasPosition.Y
    local winH = listFrame.AbsoluteSize.Y
    local firstRow = math.max(0, math.floor(y / ROW_H) - 1)
    local lastRow = math.min(rows - 1, math.floor((y + winH) / ROW_H) + 1)
    local first = firstRow * cols + 1
    local last = math.min(total, (lastRow + 1) * cols)

    for idx, card in pairs(activeCards) do
        if force or idx < first or idx > last then
            releaseCard(card)
            activeCards[idx] = nil
        end
    end

    for idx = first, last do
        if not activeCards[idx] then
            local card = acquireCard()
            activeCards[idx] = card
            bindCard(card, view[idx], idx)
            local r = (idx - 1) // cols
            local c = (idx - 1) % cols
            card.frame.Position = UDim2.fromOffset(2 + c * (CELL_W + PAD), PAD + r * ROW_H)
            card.frame.Parent = listFrame
        end
    end
    updateHighlights()
    state.scheduleImages()
end
state.relayout = layoutVisible

-- coalesce scroll/resize events so the grid updates at most once per frame
local function queueLayout()
    if layoutQueued then return end
    layoutQueued = true
    task.defer(function()
        layoutQueued = false
        layoutVisible(false)
    end)
end

listFrame:GetPropertyChangedSignal("CanvasPosition"):Connect(queueLayout)
listFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(queueLayout)

render = function()
    renderToken = renderToken + 1

    UIX.settingsPanel.Visible = state.tab == "Settings"
    if state.tab == "Settings" then
        if state.refreshSettings then state.refreshSettings() end
        listFrame.Visible = false
        bindList.Visible = false
        emptyLabel.Visible = false
        releaseAllCards()
        updateCount()
        return
    end

    if state.tab == "Binds" then
        listFrame.Visible = false
        bindList.Visible = true
        releaseAllCards()
        renderBinds()
        return
    end

    bindList.Visible = false
    listFrame.Visible = true
    releaseAllCards()

    state.view = currentList()
    listFrame.CanvasPosition = Vector2.new(0, 0)

    local loading = (state.tab == "Emotes" and state.loadingEmotes) or (state.tab == "Packs" and state.loadingPacks)
    if #state.view == 0 then
        emptyLabel.Visible = true
        if loading then
            emptyLabel.Text = "Loading..."
        elseif state.search ~= "" then
            emptyLabel.Text = "Nothing matches your search."
        elseif state.tab == "Favorites" then
            emptyLabel.Text = "No favorites yet.\nPress the star on any emote or anim pack to add it here."
        else
            emptyLabel.Text = "Nothing to show."
        end
    else
        emptyLabel.Visible = false
    end

    updateCount()
    layoutVisible(true)
end

