-- Binds (data + actions)
------------------------------------------------------------------------
local listening = nil -- { kind, id, name, bundledItems, category }

local function sameTarget(a, b)
    return a.kind == b.kind
        and tostring(a.id) == tostring(b.id)
        and (a.category or "") == (b.category or "")
end

local function findBindFor(item, category)
    local probe = { kind = item.kind, id = item.id, category = category }
    for _, b in ipairs(state.binds) do
        if sameTarget(b, probe) then return b end
    end
    return nil
end

function UIX.bindDescription(b)
    if b.kind == "emote" then return "Emote" end
    return "Anim pack - " .. (b.category and UIX.capitalize(b.category) or "Full")
end

local function refreshBindLabels()
    local cat = currentCategory()
    for _, card in pairs(activeCards) do
        if card.item then
            local b = findBindFor(card.item, cat)
            card.bindBtn.Text = b and keyLabel(b.key) or "BIND"
            card.bindBtn.TextColor3 = b and C.accent or C.text
        end
    end
    if state.tab == "Binds" then
        renderBinds()
    end
end

local function assignBind(target, keyName)
    local replaced
    for i = #state.binds, 1, -1 do
        local b = state.binds[i]
        if b.key == keyName and not sameTarget(b, target) then
            replaced = b
        end
        if b.key == keyName or sameTarget(b, target) then
            table.remove(state.binds, i)
        end
    end
    table.insert(state.binds, decorate({
        key = keyName,
        kind = target.kind,
        id = target.id,
        name = target.name,
        bundledItems = target.bundledItems,
        category = target.category,
    }))
    rebuildBindIndex()
    saveBinds()
    refreshBindLabels()
    if replaced then
        setStatus(("%s now runs %s (replaced %s)"):format(keyLabel(keyName), target.name, replaced.name))
    else
        setStatus(("Bound %s to %s"):format(keyLabel(keyName), target.name))
    end
end

local function removeBind(bind)
    for i, b in ipairs(state.binds) do
        if b == bind then
            table.remove(state.binds, i)
            break
        end
    end
    rebuildBindIndex()
    saveBinds()
    refreshBindLabels()
end

startListening = function(item, category)
    listening = {
        kind = item.kind,
        id = item.id,
        name = item.name,
        bundledItems = item.bundledItems,
        category = category,
    }
    setStatus("Press a key for " .. item.name .. " (Esc = cancel)", true)
end

local function runBind(bind)
    if bind.kind == "emote" then
        if state.track and tostring(state.activeEmote) == tostring(bind.id) then
            stopTrack()
            setStatus("Stopped")
        else
            playEmote(bind)
        end
    else
        applyPack(bind, bind.category)
    end
end

local conns = {}
local noclipKeyListening = false
state.noclipKeyChanged = function() end -- replaced once the Settings buttons exist

table.insert(conns, UserInputService.InputBegan:Connect(function(input, processed)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    if noclipKeyListening then
        local name = input.KeyCode.Name
        if input.KeyCode == Enum.KeyCode.Escape then
            noclipKeyListening = false
            setStatus("Noclip key cancelled")
            state.noclipKeyChanged()
        elseif input.KeyCode == Enum.KeyCode.Unknown then
            return
        elseif RESERVED_KEYS[name] then
            setStatus("That key is reserved - pick another", true)
        elseif bindsByKey[name] then
            setStatus("That key is used by a bind - pick another", true)
        else
            noclipKeyListening = false
            state.noclipKey = name
            saveSettings()
            setStatus("Noclip key set to " .. keyLabel(name))
            state.noclipKeyChanged()
        end
        return
    end

    if listening then
        local target = listening
        if input.KeyCode == Enum.KeyCode.Escape then
            listening = nil
            setStatus("Bind cancelled")
        elseif input.KeyCode == Enum.KeyCode.Unknown then
            return
        elseif RESERVED_KEYS[input.KeyCode.Name] then
            setStatus("That key is reserved - pick another", true)
        elseif state.noclipKey and input.KeyCode.Name == state.noclipKey then
            setStatus("That key toggles noclip - pick another", true)
        else
            listening = nil
            assignBind(target, input.KeyCode.Name)
        end
        return
    end

    if UserInputService:GetFocusedTextBox() then return end

    if state.noclipKey and input.KeyCode.Name == state.noclipKey then
        if state.toggleNoclip then state.toggleNoclip() end
        return
    end

    -- `processed` is ignored on purpose: Roblox marks number keys (the hotbar) and
    -- many game-used keys as already handled, which made those binds do nothing.
    -- Typing in a text box is still skipped above.
    if not state.bindsEnabled then
        if bindsByKey[input.KeyCode.Name] then
            setStatus("Keybinds are OFF - turn them on in the Binds tab")
        end
        return
    end

    local bind = bindsByKey[input.KeyCode.Name]
    if bind then
        local ok, err = pcall(runBind, bind)
        if not ok then setStatus("Bind error: " .. tostring(err)) end
    end
end))

