UIX.packCacheToken = 0
local function savePackCacheSoon()
    UIX.packCacheToken = UIX.packCacheToken + 1
    local token = UIX.packCacheToken
    task.delay(1, function()
        if token == UIX.packCacheToken then
            writeJson(UIX.PACKCACHE_FILE, mappingCache)
        end
    end)
end

