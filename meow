local function favKey(kind, id)
    return kind .. ":" .. tostring(id)
end

function UIX.capitalize(s)
    return (s:sub(1, 1):upper() .. s:sub(2))
end

local function keyLabel(name)
    return UIX.KEY_LABELS[name] or name
end

local function decorate(item)
    item.lname = tostring(item.name or ""):lower()
    item.sid = tostring(item.id)
    return item
end

do -- favorites (migrates old "state" entries to "pack")
    local loaded = readJson(UIX.FAV_FILE)
    if loaded then
        for _, fav in ipairs(loaded) do
            if type(fav) == "table" and fav.id then
                local kind = fav.kind == "state" and "pack" or fav.kind
                if kind == "emote" or kind == "pack" then
                    table.insert(state.favorites, decorate({
                        kind = kind,
                        id = tonumber(fav.id) or fav.id,
                        name = tostring(fav.name or ("Item_" .. tostring(fav.id))),
                        bundledItems = fav.bundledItems,
                    }))
                    state.favSet[favKey(kind, fav.id)] = true
                end
            end
        end
    end
end

local bindsByKey = {}
local function rebuildBindIndex()
    bindsByKey = {}
    for _, b in ipairs(state.binds) do
        bindsByKey[b.key] = b
    end
end

do -- binds
    local loaded = readJson(UIX.BINDS_FILE)
    if loaded then
        for _, b in ipairs(loaded) do
            if type(b) == "table" and type(b.key) == "string" and b.id and (b.kind == "emote" or b.kind == "pack") then
                table.insert(state.binds, decorate({
                    key = b.key,
                    kind = b.kind,
                    id = tonumber(b.id) or b.id,
                    name = tostring(b.name or ("Item_" .. tostring(b.id))),
                    bundledItems = b.bundledItems,
                    category = type(b.category) == "string" and b.category or nil,
                }))
            end
        end
    end
    rebuildBindIndex()
end

local function saveFavorites()
    local out = {}
    for _, f in ipairs(state.favorites) do
        table.insert(out, { kind = f.kind, id = f.id, name = f.name, bundledItems = f.bundledItems })
    end
    writeJson(UIX.FAV_FILE, out)
end

local function saveBinds()
    local out = {}
    for _, b in ipairs(state.binds) do
        table.insert(out, {
            key = b.key, kind = b.kind, id = b.id, name = b.name,
            bundledItems = b.bundledItems, category = b.category,
        })
    end
    writeJson(UIX.BINDS_FILE, out)
end

local function saveSettings()
    writeJson(UIX.SETTINGS_FILE, {
        speed = state.speed,
        width = sizeNow.X,
        height = sizeNow.Y,
        bindsEnabled = state.bindsEnabled,
        tab = state.tab,
        walkStop = state.walkStop,
        noclip = state.noclip,
        noclipKey = state.noclipKey or "",
        antifling = state.antifling,
        noHead = state.noHead,
        cfValue = state.cfValue,
        cframeSpeedOn = state.cframeSpeedOn,
        packCategory = state.packCategory,
        posX = state.posX,
        posY = state.posY,
    })
end

local function toggleFavorite(item)
    state.filterCache = nil -- favorites list is about to change
    local key = favKey(item.kind, item.id)
    if state.favSet[key] then
        state.favSet[key] = nil
        for i, fav in ipairs(state.favorites) do
            if favKey(fav.kind, fav.id) == key then
                table.remove(state.favorites, i)
                break
            end
        end
        saveFavorites()
        return false
    end
    state.favSet[key] = true
    table.insert(state.favorites, decorate({
        kind = item.kind,
        id = item.id,
        name = item.name,
        bundledItems = item.bundledItems,
    }))
    saveFavorites()
    return true
end

-- cached pack mappings (idle/walk/run/... animation ids per pack), saved to disk
