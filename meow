local function unload()
    if UIX.unloaded then return end
    UIX.unloaded = true
    renderToken = renderToken + 1
    for _, c in ipairs(conns) do
        pcall(function() c:Disconnect() end)
    end
    pcall(function()
        if state.track then state.track:Stop() end
    end)
    pcall(restoreCollisions)
    pcall(restoreOthers)
    state.cframeSpeedOn = false
    pcall(setHeadStill, false)
    -- unloading (re-execute): put the character's original animations back
    pcall(function()
        local hum, char = getHumanoid()
        local animate = char and char:FindFirstChild("Animate")
        if hum and animate and state.snapshot and state.snapshot.char == char then
            restoreDefaults(animate, nil)
            restartAnimate(hum, animate)
        elseif hum then
            for _, t in ipairs(hum:GetPlayingAnimationTracks()) do
                if t.Priority == Enum.AnimationPriority.Action then t:Stop() end
            end
        end
    end)
    state.activePack = nil
    state.activeParts = {}
    state.track = nil
    if env.EmoteHubGui == gui then env.EmoteHubGui = nil end
    if env.EmoteHubCleanup == unload then env.EmoteHubCleanup = nil end
    pcall(function() gui:Destroy() end) -- make sure the old window is really gone
end
