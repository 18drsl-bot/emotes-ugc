local noclipOriginal = {} -- part -> original CanCollide

local function restoreCollisions()
    for part, original in pairs(noclipOriginal) do
        pcall(function() part.CanCollide = original end)
        noclipOriginal[part] = nil
    end
end

UIX.noclipParts, UIX.noclipChar, UIX.noclipRefreshAt = {}, nil, 0

table.insert(conns, RunService.Stepped:Connect(function()
    if not state.noclip then return end
    local char = LocalPlayer.Character
    if not char then return end

    -- the part list is rebuilt twice a second (and on respawn), not every frame
    local now = os.clock()
    if char ~= UIX.noclipChar or now >= UIX.noclipRefreshAt then
        UIX.noclipChar = char
        UIX.noclipRefreshAt = now + 0.5
        UIX.noclipParts = {}
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("BasePart") then UIX.noclipParts[#UIX.noclipParts + 1] = d end
        end
    end

    for i = 1, #UIX.noclipParts do
        local d = UIX.noclipParts[i]
        if d.CanCollide then
            noclipOriginal[d] = true
            d.CanCollide = false
        end
    end
end))

------------------------------------------------------------------------
-- Anti-fling
--  1) other players' bodies stop colliding with you (on your screen only), so
--     they can't push or spin you
--  2) if something still launches you, the launch is cancelled and you're put
--     back where you were a moment ago
------------------------------------------------------------------------
local safeHistory = {} -- { t = os.clock(), cf = CFrame } while you are moving normally
local afTouched = setmetatable({}, { __mode = "k" }) -- other players' parts we turned non-collidable
UIX.afParts, UIX.afRefreshAt = {}, 0
UIX.afCheck, UIX.afCooldown = 0, 0

local function restoreOthers()
    for part in pairs(afTouched) do
        pcall(function() part.CanCollide = true end)
        afTouched[part] = nil
    end
end

table.insert(conns, RunService.Stepped:Connect(function()
    if not state.antifling then return end

    -- the list of other players' parts is rebuilt a couple of times a second
    local now = os.clock()
    if now >= UIX.afRefreshAt then
        UIX.afRefreshAt = now + 0.4
        local parts = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                for _, d in ipairs(plr.Character:GetDescendants()) do
                    if d:IsA("BasePart") then parts[#parts + 1] = d end
                end
            end
        end
        UIX.afParts = parts
    end

    local parts = UIX.afParts
    for i = 1, #parts do
        local d = parts[i]
        if d.CanCollide then
            afTouched[d] = true
            d.CanCollide = false
        end
    end
end))

table.insert(conns, RunService.Heartbeat:Connect(function(dt)
    if not state.antifling then return end
    UIX.afCheck = UIX.afCheck + dt
    if UIX.afCheck < 0.05 then return end
    UIX.afCheck = 0

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 or hum.Sit then return end -- vehicles are fast on purpose

    local now = os.clock()
    if now < UIX.afCooldown then return end

    local vel = hrp.AssemblyLinearVelocity
    local horizontal = Vector3.new(vel.X, 0, vel.Z).Magnitude
    local spin = hrp.AssemblyAngularVelocity.Magnitude

    -- what counts as "too fast" follows your own WalkSpeed / jump, so speed hacks aren't mistaken for flings
    local allowed = math.max(120, hum.WalkSpeed * 2.5)
    local allowedUp = math.max(120, (hum.JumpPower or 50) * 2.5)
    local flung = horizontal > allowed or vel.Y > allowedUp or spin > 40

    if flung then
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("BasePart") then
                d.AssemblyLinearVelocity = Vector3.zero
                d.AssemblyAngularVelocity = Vector3.zero
            end
        end

        -- a spot from just before it happened (at least 0.3s old)
        local target
        for i = #safeHistory, 1, -1 do
            if now - safeHistory[i].t >= 0.3 then target = safeHistory[i].cf break end
        end
        if target and (hrp.Position - target.Position).Magnitude > 12 then
            hrp.CFrame = target
            for i = #safeHistory, 1, -1 do
                if safeHistory[i].cf ~= target then table.remove(safeHistory, i) else break end
            end
            setStatus("Anti-fling: launch cancelled, put you back")
        else
            setStatus("Anti-fling: launch cancelled")
        end
        UIX.afCooldown = now + 0.3
        return
    end

    -- moving normally: remember where you are
    if horizontal < allowed * 0.6 and spin < 20 then
        table.insert(safeHistory, { t = now, cf = hrp.CFrame })
        while #safeHistory > 0 and now - safeHistory[1].t > 3 do
            table.remove(safeHistory, 1)
        end
    end
end))

table.insert(conns, LocalPlayer.CharacterAdded:Connect(function()
    safeHistory = {}
    noclipOriginal = {}
    UIX.afCooldown = os.clock() + 1
end))

