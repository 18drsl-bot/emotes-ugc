------------------------------------------------------------------------
-- Playback: emotes
------------------------------------------------------------------------
local function getHumanoid()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return hum, char
end

local function stopTrack()
    if state.track then
        pcall(function() state.track:Stop() end)
        state.track = nil
    end
    state.activeEmote = nil
    updateHighlights()
end

function UIX.resolveEmoteAnimationId(emoteId)
    local ok, objects = pcall(function()
        return game:GetObjects("rbxassetid://" .. tostring(emoteId))
    end)
    if not ok or type(objects) ~= "table" then return nil end

    local found
    for _, obj in ipairs(objects) do
        local candidates = obj:IsA("Animation") and { obj } or obj:GetDescendants()
        for _, d in ipairs(candidates) do
            if d:IsA("Animation") then
                local n = tonumber((tostring(d.AnimationId):match("%d+")))
                if n and n > 0 then
                    found = n
                    break
                end
            end
        end
        pcall(function() obj:Destroy() end)
        if found then break end
    end
    return found
end

local emoteAnimCache = {}
local function playEmote(item)
    local hum = getHumanoid()
    if not hum then
        setStatus("No character found")
        return
    end

    -- clicking the emote that is already playing turns it off
    if state.track and state.activeEmote ~= nil and tostring(state.activeEmote) == tostring(item.id) then
        stopTrack()
        setStatus("Stopped: " .. item.name)
        return
    end

    stopTrack()

    -- Humanoid:PlayEmote tracks are cancelled by the engine as soon as you move.
    -- With Walk stop OFF we play the animation ourselves (Action priority) so it
    -- keeps going while walking; with Walk stop ON we use the normal emote path.
    local function viaEmote()
        local ok, a, b = pcall(function()
            return hum:PlayEmoteAndGetAnimTrackById(item.id)
        end)
        if ok then
            if typeof(a) == "Instance" and a:IsA("AnimationTrack") then
                return a
            elseif typeof(b) == "Instance" and b:IsA("AnimationTrack") then
                return b
            end
        end
        return nil
    end

    local function viaAnimator()
        local animId = emoteAnimCache[item.id]
        if not animId then
            animId = UIX.resolveEmoteAnimationId(item.id)
            if animId then emoteAnimCache[item.id] = animId end
        end
        local animator = hum:FindFirstChildOfClass("Animator")
        if animId and animator then
            local anim = Instance.new("Animation")
            anim.AnimationId = "rbxassetid://" .. tostring(animId)
            local ok2, t = pcall(function() return animator:LoadAnimation(anim) end)
            if ok2 and t then
                t.Priority = Enum.AnimationPriority.Action
                pcall(function() t:Play() end)
                return t
            end
        end
        return nil
    end

    local newTrack
    if state.walkStop then
        newTrack = viaEmote() or viaAnimator()
    else
        newTrack = viaAnimator() or viaEmote()
    end

    if not newTrack then
        setStatus("Couldn't play that (R15 only)")
        return
    end

    pcall(function() newTrack.Looped = true end)
    pcall(function() newTrack:AdjustSpeed(state.speed) end)

    state.track = newTrack
    state.activeEmote = item.id
    updateHighlights()
    setStatus("Playing: " .. item.name)

    newTrack.Stopped:Connect(function()
        if state.track == newTrack then
            state.track = nil
            state.activeEmote = nil
            updateHighlights()
        end
    end)
end

------------------------------------------------------------------------
-- Playback: anim packs (whole pack or a single category)
------------------------------------------------------------------------
function UIX.resolveMappings(bundledItems)
    local mappings = {}
    for _, group in pairs(bundledItems) do
        local ids = type(group) == "table" and group or { group }
        for _, assetId in pairs(ids) do
            local ok, objects = pcall(function()
                return game:GetObjects("rbxassetid://" .. tostring(assetId))
            end)
            if ok and type(objects) == "table" then
                for _, root in ipairs(objects) do
                    for _, d in ipairs(root:GetDescendants()) do
                        if d:IsA("Animation") and d.Parent then
                            local weights = {}
                            for _, w in ipairs(d:GetChildren()) do
                                if w:IsA("NumberValue") and w.Name == "Weight" then
                                    table.insert(weights, w.Value)
                                end
                            end
                            table.insert(mappings, {
                                category = d.Parent.Name,
                                name = d.Name,
                                animationId = d.AnimationId,
                                weights = weights,
                            })
                        end
                    end
                    pcall(function() root:Destroy() end)
                end
            end
        end
    end
    return mappings
end

function UIX.setAnim(obj, m)
    obj.AnimationId = m.animationId
    if m.weights then
        for _, child in ipairs(obj:GetChildren()) do
            if child:IsA("NumberValue") and child.Name == "Weight" then
                child:Destroy()
            end
        end
        for _, value in ipairs(m.weights) do
            local w = Instance.new("NumberValue")
            w.Name = "Weight"
            w.Value = value
            w.Parent = obj
        end
    end
end

-- Remember the character's original animations the first time a pack is applied,
-- so clicking an applied pack again can put them back.
function UIX.ensureSnapshot(char, animate)
    if state.snapshot and state.snapshot.char == char then return end
    local folders = {}
    for _, child in ipairs(animate:GetChildren()) do
        if child:IsA("StringValue") or child:IsA("Folder") then
            local hasAnim = false
            for _, d in ipairs(child:GetChildren()) do
                if d:IsA("Animation") then hasAnim = true break end
            end
            if hasAnim then
                local ok, copy = pcall(function() return child:Clone() end)
                if ok and copy then folders[child.Name] = copy end
            end
        end
    end
    state.snapshot = { char = char, folders = folders }
end

local function restoreDefaults(animate, category)
    local snap = state.snapshot
    if not snap then return false end
    for name, original in pairs(snap.folders) do
        if not category or name:lower() == category then
            local live = animate:FindFirstChild(name)
            if live then
                for _, ch in ipairs(live:GetChildren()) do
                    if ch:IsA("Animation") then ch:Destroy() end
                end
                for _, ch in ipairs(original:GetChildren()) do
                    ch:Clone().Parent = live
                end
            end
        end
    end
    return true
end

local function restartAnimate(hum, animate)
    for _, t in ipairs(hum:GetPlayingAnimationTracks()) do
        t:Stop()
    end
    if hum.MoveDirection.Magnitude == 0 then
        animate.Disabled = true
        animate.Disabled = false
    end
end

local applyingPack = false
local function applyPack(item, category)
    if applyingPack then return end
    local hum, char = getHumanoid()
    local animate = char and char:FindFirstChild("Animate")
    if not hum or not animate then
        setStatus("No Animate script on character")
        return
    end

    -- clicking the pack that is already applied puts the original animations back
    local isActive
    if category then
        isActive = state.activeParts[category] ~= nil and tostring(state.activeParts[category]) == tostring(item.id)
    else
        isActive = state.activePack ~= nil and tostring(state.activePack) == tostring(item.id)
    end
    if isActive then
        if restoreDefaults(animate, category) then
            if category then
                state.activeParts[category] = nil
            else
                state.activePack = nil
                state.activeParts = {}
            end
            state.track = nil
            state.activeEmote = nil
            restartAnimate(hum, animate)
            updateHighlights()
            setStatus("Reset " .. (category or "all animations") .. " to default")
        else
            setStatus("Nothing to reset")
        end
        return
    end

    if not item.bundledItems then
        setStatus("No animation data for that pack")
        return
    end

    applyingPack = true
    setStatus("Loading " .. item.name .. "...")

    task.spawn(function()
        local key = tostring(item.id)
        local mappings = mappingCache[key]
        if not mappings or #mappings == 0 then
            mappings = UIX.resolveMappings(item.bundledItems)
            if #mappings > 0 then
                mappingCache[key] = mappings
                savePackCacheSoon()
            end
        end

        if #mappings == 0 then
            applyingPack = false
            setStatus("Couldn't load that pack")
            return
        end

        local wanted = mappings
        if category then
            wanted = {}
            for _, m in ipairs(mappings) do
                if tostring(m.category):lower() == category then
                    table.insert(wanted, m)
                end
            end
            if #wanted == 0 then
                applyingPack = false
                setStatus("That pack has no " .. category .. " animation")
                return
            end
        end

        local hum2, char2 = getHumanoid()
        local animate2 = char2 and char2:FindFirstChild("Animate")
        if not hum2 or not animate2 then
            applyingPack = false
            return
        end

        UIX.ensureSnapshot(char2, animate2)

        for _, t in ipairs(hum2:GetPlayingAnimationTracks()) do
            t:Stop()
        end
        state.track = nil
        state.activeEmote = nil

        local byCategory = {}
        for _, m in ipairs(wanted) do
            local cat = tostring(m.category):lower()
            byCategory[cat] = byCategory[cat] or { folder = m.category, items = {} }
            byCategory[cat].items[tostring(m.name):lower()] = m
        end

        for _, data in pairs(byCategory) do
            local folder = animate2:FindFirstChild(data.folder)
            if folder then
                local remaining = {}
                for k, m in pairs(data.items) do remaining[k] = m end

                for _, obj in ipairs(folder:GetChildren()) do
                    if obj:IsA("Animation") then
                        local lower = obj.Name:lower()
                        local m = remaining[lower]
                        if m then
                            remaining[lower] = nil
                            UIX.setAnim(obj, m)
                            if obj.Name ~= m.name then obj.Name = m.name end
                        else
                            obj:Destroy()
                        end
                    end
                end

                for _, m in pairs(remaining) do
                    local obj = Instance.new("Animation")
                    obj.Name = m.name
                    UIX.setAnim(obj, m)
                    obj.Parent = folder
                end
            end
        end

        if hum2.MoveDirection.Magnitude == 0 then
            animate2.Disabled = true
            animate2.Disabled = false
        end

        if category then
            state.activeParts[category] = item.id
            state.activePack = nil
        else
            state.activePack = item.id
            state.activeParts = {}
        end
        updateHighlights()
        applyingPack = false
        setStatus((category and ("Applied " .. category .. ": ") or "Applied: ") .. item.name)
    end)
end

